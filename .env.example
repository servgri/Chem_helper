# --- Django ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-before-deploy
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DB_PATH=

# Browser origin of the UI (host port 8510). Add https://<vm-ip>:8510 on Cloud.ru.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8510,http://localhost:8510
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8510,http://localhost:8510

# --- ToxMol paths (defaults work inside Docker) ---
TOXMOL_MODELS_DIR=
TOXMOL_FP_INDEX_PATH=
TOXMOL_SIMILAR_TOP_N=12
TOXMOL_RETRO_MAX_DEPTH=2
TOXMOL_FORCE_CPU=1
LOG_LEVEL=INFO

# --- Research notebook / ClearML (optional) ---
CLEARML_ENABLED=0
CLEARML_OFFLINE_MODE=1
CLEARML_PROJECT=ToxMol/Tox21-QSAR
CLEARML_API_ACCESS_KEY=
CLEARML_API_SECRET_KEY=
